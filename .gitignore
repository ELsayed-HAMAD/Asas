# ---------------------------------------------------------------------------
# Asas repository ignore rules
#
# Keep this file focused on generated, local, and sensitive files. Do not add
# broad documentation or source patterns: security policies, contribution
# guides, tests, and review artifacts must remain visible to Git.
# ---------------------------------------------------------------------------

# Logs
*.log
*.log.*
/logs/
/apps/api/logs/
/apps/web/logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lint_output.txt

# Dependencies and package-manager caches
node_modules/
.pnpm-store/
.pnpm-debug.log*
package-lock.json
yarn.lock

# Environment files and local overrides. Only sanitized templates are tracked.
.env
.env.*
!**/.env.example
*.env
!*.env.example
*.env.local
*.env.*.local
.envrc
*.envrc

# Local Compose overrides often contain machine-specific credentials.
docker-compose.override.yml
docker-compose.override.yaml
docker-compose.*.local.yml
docker-compose.*.local.yaml
compose.override.yml
compose.override.yaml

# Private keys, certificates, and credential stores
*.pem
*.key
*.p12
*.pfx
*.p8
*.pkcs8
*.ppk
*.mobileprovision
*.crt
*.cer
*.csr
*.der
*.jks
*.keystore
*.kdbx
*.keepass*
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
.netrc
_netrc
.pgpass
.npmrc
.yarnrc
.yarnrc.yml
.pypirc
**/.gem/credentials
**/.cargo/credentials
**/.cargo/credentials.toml
.aws/
.azure/
**/.config/gcloud/
.gcloud/
.kube/
kubeconfig
kubeconfig.*
*.kubeconfig
.boto
.s3cfg
.rclone.conf
**/.docker/config.json
.dockercfg
.htpasswd
*.ovpn

# Service-account keys and generated secret material
**/credentials.json
**/service-account*.json
**/*-service-account.json
**/client_secret_*.json
**/secrets.json
**/secrets.yaml
**/secrets.yml
*.secret
*.secrets
/secrets/
/apps/api/secrets/
/apps/web/secrets/

# Build output and caches
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.cache/
.vite/
.vite-temp/
.turbo/
*.tsbuildinfo
.eslintcache
.oxlintcache
.stylelintcache
.parcel-cache/
.vercel/
.netlify/
.wrangler/
.serverless/
.aws-sam/

# Infrastructure-as-code state and variable files can contain secrets
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
cdk.out/
.pulumi/

# Test and coverage output
coverage/
**/coverage/
.nyc_output/
playwright-report/
**/playwright-report/
test-results/
**/test-results/
blob-report/
**/blob-report/
allure-results/
allure-report/
cypress/videos/
cypress/screenshots/
.screens/
apps/web/.screens/
.playwright/
**/trace.zip
*.har
*.pcap
*.pcapng
*.heapsnapshot
*.cpuprofile
apps/web/.tmp/
apps/web/.turbo/

# Runtime data. Never commit uploads, generated exports, resumes, or local
# database files. See the deployment notes for the S3 migration path.
/storage/
/apps/api/storage/
/apps/api/uploads/
/apps/api/resumes/
/apps/api/exports/
/uploads/
/resumes/
/exports/
/tmp/
/temp/
/.tmp/
.tmp-shims/
*.pid
*.seed

# Local databases and dumps
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.dump
*.sql.gz
*.sql.tar
*.sql.bz2
*.sql.xz
*.bak
*.backup
*.aof
dump.rdb
*.rdb

# Local backups and private notes go outside the repository.
*backup*/
*_backup_*
docs/internal/
internal-notes/

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.fleet/
.history/
*.iml
*.suo
*.sw?
*.orig
*.rej
*~
*.code-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Local AI/editor tool state. These are contributor-specific and must not be
# published as project configuration.
.claude/
.claude.json
.claude.json.*
.codex/
.cursor/
.cursorrules
.windsurf/
.windsurfrules
.aider*
.continue/
.codeium/
.copilot/
.opencode/
.zed/
.agents/
.agent/
.cline/
.roo/
.gemini
.trae/
.kilocode/
.amazonq/
.qoder/
.monkeyscode/

# Credential stores, CLI auth tokens, and MCP server configs. These live on the
# contributor's machine and often hold live provider secrets.
.git-credentials
.ssh/
*.gpg
*.pgp
*.asc
*.agekey
age-key.txt
.sentryclirc
sentry.properties
.stripe/
.mcp.json
.mcp/

.vercel
.env*
