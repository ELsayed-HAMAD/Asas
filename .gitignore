# ---------------------------------------------------------------------------
# Asas repository ignore rules
#
# Keep this file focused on generated, local, and sensitive files. Do not add
# broad documentation or source patterns: security policies, contribution
# guides, tests, and review artifacts must remain visible to Git.
# ---------------------------------------------------------------------------

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lint_output.txt

# Dependencies and package-manager caches
node_modules/
.pnpm-store/
.pnpm-debug.log*
package-lock.json
yarn.lock

# Environment files and local overrides. Only sanitized templates are tracked.
.env
.env.*
!.env.example
!**/.env.example
*.env.local
*.env.*.local
.envrc
*.envrc

# Private keys, certificates, and credential stores
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.csr
*.der
*.jks
*.keystore
*.kdbx
*.keepass*
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
.netrc
.pgpass
.npmrc
.dockercfg
.htpasswd
*.ovpn

# Build output and caches
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.cache/
.vite/
.vite-temp/
.turbo/
*.tsbuildinfo
.eslintcache
.oxlintcache
.stylelintcache
.parcel-cache/
.vercel/
.netlify/
.wrangler/
.serverless/
.aws-sam/

# Test and coverage output
coverage/
**/coverage/
.nyc_output/
playwright-report/
**/playwright-report/
test-results/
**/test-results/
blob-report/
**/blob-report/
allure-results/
allure-report/
cypress/videos/
cypress/screenshots/
apps/web/.tmp/
apps/web/.turbo/

# Runtime data. Never commit uploads, generated exports, resumes, or local
# database files. See the deployment notes for the S3 migration path.
storage/
apps/api/storage/
uploads/
resumes/
exports/
tmp/
temp/
.tmp/
.tmp-shims/
*.pid
*.seed

# Local databases and dumps
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.dump
*.sql.gz
*.sql.tar
*.bak
*.backup
dump.rdb
*.rdb

# Local backups and private notes go outside the repository.
*backup*/
*_backup_*
docs/internal/
internal-notes/

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.history/
*.suo
*.sw?
*.code-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Local AI/editor tool state. These are contributor-specific and must not be
# published as project configuration.
.claude/
.claude.json
.claude.json.*
.codex/
.cursor/
.cursorrules
.windsurf/
.windsurfrules
.aider*
.continue/
.codeium/
.copilot/
.opencode/
.zed/
.agents/
.agent/
.cline/
.roo/
.gemini/
.monkeyscode/
