// ─── Core ────────────────────────────────────────────────────────────────────

model Tenant {
  id                     String           @id @default(cuid())
  name                   String
  slug                   String           @unique
  supportEmail           String?
  stripeCustomerId       String?          @unique
  logoUrl                String?
  metadata               String?
  timezone               String           @default("UTC")
  currency               String           @default("USD")
  currencyLockedAt       DateTime?
  dateFormat             String           @default("MMM d, yyyy")
  overtimeThresholdHours Float            @default(8)
  onboardingStatus       OnboardingStatus @default(PENDING)
  status                 String           @default("ACTIVE")
  archivedAt             DateTime?
  suspendedAt            DateTime?
  suspendedReason        String?
  sampleDataManifest     Json?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  members                           Member[]
  invitations                       Invitation[]
  seatReservations                  SeatReservation[]
  auditLogs                         AuditLog[]
  departments                       Department[]
  activityEvents                    ActivityEvent[]
  employees                         Employee[]
  payrollRuns                       PayrollRun[]
  timesheets                        Timesheet[]
  attendanceExceptions              AttendanceException[]
  leaveRequests                     LeaveRequest[]
  leavePolicies                     LeavePolicy[]
  candidates                        Candidate[]
  vendors                           Vendor[]
  payableInvoices                   PayableInvoice[]
  customers                         Customer[]
  receivableInvoices                ReceivableInvoice[]
  expenses                          Expense[]
  ledgerTransactions                LedgerTransaction[]
  ledgerAccounts                    LedgerAccount[]
  exchangeRates                     ExchangeRate[]
  journalEntries                    JournalEntry[]
  cashFlowSnapshots                 CashFlowSnapshot[]
  bankStatementImports              BankStatementImport[]
  bankStatementLines                BankStatementLine[]
  companies                         Company[]
  deals                             Deal[]
  dealStageHistory                  DealStageHistory[]
  crmHistoryCoverage                CrmHistoryCoverage?
  settlementHistoryCoverage         SettlementHistoryCoverage?
  dealActivities                    DealActivity[]
  agendaItems                       AgendaItem[]
  salesQuotas                       SalesQuota[]
  forecastSnapshots                 ForecastSnapshot[]
  products                          Product[]
  suppliers                         Supplier[]
  purchaseOrders                    PurchaseOrder[]
  projects                          Project[]
  sprints                           Sprint[]
  roadmapPhases                     RoadmapPhase[]
  subscriptions                     Subscription[]
  paymentMethods                    PaymentMethod[]
  billingInvoices                   BillingInvoice[]
  integrations                      Integration[]
  notificationPrefs                 NotificationPreference[]
  quietHours                        QuietHours?
  exportJobs                        ExportJob[]
  backupSchedules                   BackupSchedule[]
  supportTickets                    SupportTicket[]
  notifications                     Notification[]
  inventoryValuationConfig          InventoryValuationConfig?
  inventoryValuationAccountMappings InventoryValuationAccountMapping[]
  inventoryValuationBalances        InventoryValuationBalance[]
  inventoryCostLayers               InventoryCostLayer[]
  inventoryValuationEvents          InventoryValuationEvent[]
  inventoryCostAllocations          InventoryCostAllocation[]
  receivableInventoryLines          ReceivableInventoryLine[]
  purchaseOrderInvoiceMatches       PurchaseOrderInvoiceMatch[]
  dataMigrationProjects             DataMigrationProject[]
  dataMigrationImportJobs           DataMigrationImportJob[]
  dataMigrationRecordLinks          DataMigrationRecordLink[]
  dataMigrationStageBatches         DataMigrationStageBatch[]
  dataMigrationStagedRecords        DataMigrationStagedRecord[]
}

/// Durable company-wide migration plan. Individual imports remain typed and are added as
/// supported entity adapters are implemented; this record is their shared project scope.
model DataMigrationProject {
  id                      String                     @id @default(cuid())
  tenantId                String
  name                    String
  sourceSystem            String?
  modules                 DataMigrationModule[]
  status                  DataMigrationProjectStatus @default(PLANNING)
  createdDuringOnboarding Boolean                    @default(false)
  targetCutoverAt         DateTime?
  createdBy               String
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  tenant        Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobs          DataMigrationImportJob[]
  recordLinks   DataMigrationRecordLink[]
  stageBatches  DataMigrationStageBatch[]
  stagedRecords DataMigrationStagedRecord[]

  @@index([tenantId, updatedAt])
  @@index([tenantId, status])
  @@index([tenantId, createdDuringOnboarding, status, updatedAt])
}

/// Completed entity imports linked to their company project. Additional entity/status values
/// are added together with their staged import adapters so history never claims fake jobs.
model DataMigrationImportJob {
  id             String                    @id @default(cuid())
  tenantId       String
  projectId      String
  entity         DataMigrationEntity
  status         DataMigrationImportStatus @default(COMPLETED)
  idempotencyKey String
  requestHash    String
  totalRows      Int
  importedRows   Int
  createdBy      String
  createdAt      DateTime                  @default(now())
  completedAt    DateTime                  @default(now())

  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     DataMigrationProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recordLinks DataMigrationRecordLink[]

  @@unique([tenantId, projectId, entity, idempotencyKey])
  @@index([tenantId, projectId, createdAt])
  @@index([tenantId, entity, status])
}

/// Maps stable source IDs to Asas IDs so later entity batches can preserve cross-module links.
model DataMigrationRecordLink {
  id           String              @id @default(cuid())
  tenantId     String
  projectId    String
  importJobId  String
  sourceEntity DataMigrationEntity
  sourceId     String
  targetEntity DataMigrationEntity
  targetId     String
  createdAt    DateTime            @default(now())

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   DataMigrationProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  importJob DataMigrationImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@unique([tenantId, projectId, sourceEntity, sourceId])
  @@index([tenantId, targetEntity, targetId])
  @@index([tenantId, importJobId])
}

/// A durable, validated source batch held separately from operational records until cutover.
model DataMigrationStageBatch {
  id             String                   @id @default(cuid())
  tenantId       String
  projectId      String
  entity         DataMigrationEntity
  sequence       Int                      @default(1)
  status         DataMigrationStageStatus @default(STAGED)
  idempotencyKey String
  requestHash    String
  totalRows      Int
  stagedRows     Int
  metadata       Json?
  createdBy      String
  createdAt      DateTime                 @default(now())
  completedAt    DateTime?

  tenant  Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project DataMigrationProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  records DataMigrationStagedRecord[]

  @@unique([tenantId, projectId, entity, idempotencyKey])
  @@unique([tenantId, projectId, entity, sequence])
  @@index([tenantId, projectId, createdAt])
  @@index([tenantId, projectId, entity, status])
}

/// Raw validated migration row, retained for review/reconciliation and never exposed as an invoice.
model DataMigrationStagedRecord {
  id        String              @id @default(cuid())
  tenantId  String
  projectId String
  batchId   String
  entity    DataMigrationEntity
  sourceId  String
  revision  Int                 @default(1)
  isCurrent Boolean             @default(true)
  payload   Json
  createdAt DateTime            @default(now())

  tenant  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project DataMigrationProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  batch   DataMigrationStageBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, projectId, entity, sourceId, revision])
  @@index([tenantId, projectId, entity, batchId])
  @@index([tenantId, projectId, entity, sourceId, isCurrent])
}

// ─── Auth (Better Auth core + organization plugin, mapped onto Tenant) ───────
//
// `User` no longer carries `tenantId`/`passwordHash`/`role`/`employeeId` — a user's
// workspace membership, credential, and per-tenant role/employee link now live on `Member`,
// because a single person can belong to more than one tenant. See ADR note in the rebuild
// plan, Phase 1 §4 ("Better Auth — the one delicate migration").
model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  twoFactorEnabled Boolean  @default(false)
  platformRole     PlatformRole @default(NONE)
  image            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions             Session[]
  accounts             Account[]
  members              Member[]
  sentInvitations      Invitation[]    @relation("InvitationInviter")
  auditLogs            AuditLog[]
  exchangeRatesCreated ExchangeRate[]
  twoFactors           TwoFactor[]
  supportTickets       SupportTicket[]
  notifications        Notification[]
}

model TwoFactor {
  id                      String    @id @default(cuid())
  userId                  String
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
}

model Session {
  id                   String   @id @default(cuid())
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  // Set only when this session completed a Better Auth second-factor challenge. OAuth
  // callbacks and trusted-device sign-ins create sessions without one, so privileged
  // surfaces such as the platform console use it to require a step-up verification.
  twoFactorVerifiedAt  DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Credential (email/password) and future OAuth accounts. `password` holds the bcrypt/scrypt
// hash for the `credential` provider — this is where `User.passwordHash` moved to.
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  /**
   * better-auth 1.7.2's internal adapter always writes this (e.g. "local:credential") —
   * confirmed by running an actual sign-up against a live database; not documented anywhere
   * I found ahead of time. Nullable here in case an older/newer better-auth version omits it.
   */
  issuer                String?
  userId                String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Email verification / password reset tokens.
model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

// The organization plugin's `member` model, mapped so its tenant column is named `tenantId`
// like every other one of the 60 ERP models (see apps/api/src/auth.ts). `role` intentionally
// reuses the `UserRole` enum rather than better-auth's default lowercase strings — see the
// note in auth.ts about the resulting gap in built-in permission checks.
model Member {
  id                String   @id @default(cuid())
  tenantId          String
  userId            String
  employeeId        String?  @unique
  role              UserRole @default(MEMBER)
  seatReservationId String?
  createdAt         DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([tenantId, seatReservationId])
}

model Invitation {
  id                String   @id @default(cuid())
  tenantId          String
  email             String
  role              UserRole @default(MEMBER)
  status            String   @default("pending")
  inviterId         String
  seatReservationId String?
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inviter User   @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, seatReservationId])
}

// Short-lived reservations bridge Better Auth's separate before/after database hooks so
// concurrent invitations and membership changes cannot all pass the same seat preflight.
model SeatReservation {
  id           String   @id @default(cuid())
  tenantId     String
  invitationId String?
  purpose      String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, invitationId])
  @@index([tenantId, expiresAt])
}

// Append-only record of privileged actions (payroll approval, salary edits, member-role
// changes, …). Nothing in this codebase exposes an update or delete for this table — that is
// the "append-only" guarantee today. TODO(phase-1-hardening): enforce it at the database
// level too (a REVOKE + trigger, or a restricted DB role for the app connection) once there is
// a live database to verify that against; see the rebuild plan, Phase 1 §5.
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
}

/// Immutable trail of platform-operator actions. Not tenant-owned and not RLS-scoped.
model PlatformAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

/// Global platform switches (maintenance, signups, exports). Not tenant-owned.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]
  projects  Project[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ActivityEvent {
  id        String   @id @default(cuid())
  tenantId  String
  module    String
  actorName String
  action    String
  target    String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, module])
  @@index([tenantId, createdAt])
}

// ─── HR ──────────────────────────────────────────────────────────────────────

enum SalaryBasis {
  ANNUAL
  MONTHLY
}

enum PayFrequency {
  MONTHLY
  SEMIMONTHLY
  BIWEEKLY
  WEEKLY
}

model Employee {
  id                String         @id @default(cuid())
  tenantId          String
  currency          String?
  departmentId      String?
  managerId         String?
  name              String
  title             String
  status            EmployeeStatus @default(ACTIVE)
  avatarUrl         String?
  hiredAt           DateTime?
  employmentEndDate DateTime?      @db.Date
  salary            Decimal?       @db.Decimal(19, 4)
  salaryBasis       SalaryBasis?
  equityOptions     Int?
  band              String?
  location          String?
  employeeNumber    String?
  email             String?
  bankRoutingNumber String?
  bankAccountNumber String?
  bankAccountType   String?
  bankIban          String?
  bankBic           String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department       Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager          Employee?               @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports          Employee[]              @relation("EmployeeManager")
  member           Member?
  salaryHistory    EmployeeSalaryHistory[]
  payrollLines     PayrollLine[]
  timesheets       Timesheet[]
  exceptions       AttendanceException[]
  leaveRequests    LeaveRequest[]
  ownedDeals       Deal[]
  expenses         Expense[]
  issueAssignees   IssueAssignee[]
  roadmapAssignees RoadmapTaskAssignee[]
  hiredCandidate   Candidate?

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@index([tenantId, status])
}

model EmployeeSalaryHistory {
  id            String       @id @default(cuid())
  tenantId      String
  employeeId    String
  salary        Decimal      @db.Decimal(19, 4)
  salaryBasis   SalaryBasis?
  currency      String
  effectiveFrom DateTime     @db.Date
  createdById   String?
  createdAt     DateTime     @default(now())

  employee Employee @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([employeeId, effectiveFrom])
  @@index([tenantId, employeeId, effectiveFrom])
}

model PayrollRun {
  id              String           @id @default(cuid())
  tenantId        String
  label           String
  payDate         DateTime?
  periodStart     DateTime?        @db.Date
  periodEnd       DateTime?        @db.Date
  payFrequency    PayFrequency?
  periodsPerYear  Int?
  salaryBasis     SalaryBasis?
  prorationMethod String?
  currency        String?
  createdById     String?
  approvedAt      DateTime?
  approvedById    String?
  paidAt          DateTime?
  paidById        String?
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?
  requestKey      String?
  requestHash     String?
  status          PayrollRunStatus @default(PENDING)
  /// JSON array of `{ label, rate }` rows — the tax/deduction rates this run was priced
  /// with, stored on the run so the tax split stays auditable and re-computable.
  taxRates        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines               PayrollLine[]
  settlementJournals  JournalEntry[]
  recognitionJournals JournalEntry[] @relation("PayrollRecognition")

  @@unique([tenantId, requestKey])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, periodStart, periodEnd])
}

model PayrollLine {
  id                 String       @id @default(cuid())
  tenantId           String
  payrollRunId       String
  employeeId         String
  gross              Decimal      @default(0) @db.Decimal(19, 4)
  deductions         Decimal      @default(0) @db.Decimal(19, 4)
  net                Decimal      @default(0) @db.Decimal(19, 4)
  baseSalary         Decimal?     @db.Decimal(19, 4)
  sourceSalary       Decimal?     @db.Decimal(19, 4)
  salaryBasis        SalaryBasis?
  salaryRateSegments Json?
  eligibleDays       Int?
  periodDays         Int?
  missedDaysCount    Int?
  missedDaysAmount   Decimal?     @db.Decimal(19, 4)
  bonusLabel         String?
  bonusAmount        Decimal?     @db.Decimal(19, 4)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  payrollRun PayrollRun       @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  taxLines   PayrollTaxLine[]

  @@index([tenantId])
  @@index([payrollRunId])
}

model PayrollTaxLine {
  id            String  @id @default(cuid())
  payrollLineId String
  label         String
  amount        Decimal @db.Decimal(19, 4)
  override      Boolean @default(false)

  payrollLine PayrollLine @relation(fields: [payrollLineId], references: [id], onDelete: Cascade)
}

model Timesheet {
  id                     String    @id @default(cuid())
  tenantId               String
  employeeId             String
  weekStart              DateTime
  regularHours           Float     @default(0)
  overtimeHours          Float     @default(0)
  totalHours             Float     @default(0)
  overtimeThresholdHours Float     @default(8)
  approvedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  days     TimesheetDay[]

