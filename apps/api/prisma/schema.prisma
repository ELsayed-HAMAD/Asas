  tenantId        String
  currency        String?
  name            String
  sku             String
  price           Decimal            @default(0) @db.Decimal(19, 4)
  stock           Int                @default(0)
  status          ProductStockStatus @default(IN_STOCK)
  warehouse       String?
  aisle           String?
  bin             String?
  avgMonthlyUsage Float?
  leadTimeDays    Int?
  minThreshold    Int                @default(10)
  archivedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant                   Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements                StockMovement[]
  suppliers                ProductSupplier[]
  poLines                  PurchaseOrderLine[]
  valuationBalance         InventoryValuationBalance?
  costLayers               InventoryCostLayer[]
  valuationEvents          InventoryValuationEvent[]
  receivableInventoryLines ReceivableInventoryLine[]

  @@unique([tenantId, sku])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, archivedAt])
}

model StockMovement {
  id          String   @id @default(cuid())
  tenantId    String
  productId   String
  delta       Int
  note        String?
  /// Stable client-generated UUID for a manual movement. State-guarded system movements leave
  /// both request fields NULL; a repeated manual request returns the original movement instead
  /// of advancing stock twice.
  requestKey  String?
  requestHash String?
  createdAt   DateTime @default(now())

  product                 Product                   @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade)
  valuationEvent          InventoryValuationEvent?
  costLayer               InventoryCostLayer?
  receivableIssueLines    ReceivableInventoryLine[] @relation("ReceivableInventoryIssueMovement")
  receivableReversalLines ReceivableInventoryLine[] @relation("ReceivableInventoryReversalMovement")

  @@unique([id, tenantId])
  @@unique([tenantId, requestKey])
  @@index([tenantId])
}

/// Company policy and default chart-of-account mappings for perpetual inventory valuation.
/// It is absent on existing workspaces until an administrator completes costing setup.
model InventoryValuationConfig {
  tenantId      String                 @id
  costingMethod InventoryCostingMethod
  configuredAt  DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Explicit posting accounts for one currency. There are intentionally no defaults: a business
/// must map real ledger accounts before valued inventory can post financial journals.
model InventoryValuationAccountMapping {
  id                                  String   @id @default(cuid())
  tenantId                            String
  currency                            String
  inventoryAssetAccountCode           String
  costOfGoodsSoldAccountCode          String
  goodsReceivedNotInvoicedAccountCode String
  adjustmentExpenseAccountCode        String
  adjustmentGainAccountCode           String
  createdAt                           DateTime @default(now())
  updatedAt                           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, currency])
  @@unique([id, tenantId])
  @@index([tenantId])
}

/// Cached product carrying value. Immutable movement events and FIFO allocations remain the
/// audit trail; this row is the transactionally maintained current position.
model InventoryValuationBalance {
  id             String   @id @default(cuid())
  tenantId       String
  productId      String
  currency       String
  onHandQuantity Int      @default(0)
  inventoryValue Decimal  @default(0) @db.Decimal(19, 4)
  updatedAt      DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([productId, tenantId])
  @@unique([id, tenantId])
  @@index([tenantId, currency])
}

/// Original and remaining value for a FIFO receipt layer. A layer is never removed; issues
/// append allocations and update its remaining position in the same database transaction.
model InventoryCostLayer {
  id                String   @id @default(cuid())
  tenantId          String
  productId         String
  /// Absent when the layer represents an opening valuation of quantity that already existed;
  /// such a layer has no new stock movement and must not fabricate one.
  sourceMovementId  String?
  currency          String
  originalQuantity  Int
  remainingQuantity Int
  originalValue     Decimal  @db.Decimal(19, 4)
  remainingValue    Decimal  @db.Decimal(19, 4)
  receivedAt        DateTime
  createdAt         DateTime @default(now())

  tenant         Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product        Product                   @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  sourceMovement StockMovement?            @relation(fields: [sourceMovementId, tenantId], references: [id, tenantId], onDelete: Restrict)
  allocations    InventoryCostAllocation[]

  @@unique([sourceMovementId, tenantId])
  @@unique([id, tenantId])
  @@index([tenantId, productId, receivedAt, id])
}

/// Valuation result for a stock movement, linked to the journal that changed inventory and its
/// corresponding offset account. Legacy quantity movements without a cost event remain unvalued.
model InventoryValuationEvent {
  id              String                 @id @default(cuid())
  tenantId        String
  productId       String
  /// Set only for a purchase-order receipt. This link lets Finance match an AP bill to the
  /// exact valued receipt that established the goods-received-not-invoiced balance.
  purchaseOrderId String?
  /// Absent for an opening valuation of existing quantity (no new movement occurred).
  stockMovementId String?
  journalEntryId  String?
  costingMethod   InventoryCostingMethod
  reason          InventoryCostReason
  quantityDelta   Int
  costValue       Decimal                @db.Decimal(19, 4)
  currency        String
  postedAt        DateTime
  createdAt       DateTime               @default(now())

  tenant                  Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product                 Product                     @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  purchaseOrder           PurchaseOrder?              @relation(fields: [purchaseOrderId, tenantId], references: [id, tenantId], onDelete: Restrict)
  stockMovement           StockMovement?              @relation(fields: [stockMovementId, tenantId], references: [id, tenantId], onDelete: Restrict)
  journalEntry            JournalEntry?               @relation(fields: [journalEntryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  allocations             InventoryCostAllocation[]
  receivableIssueLines    ReceivableInventoryLine[]   @relation("ReceivableInventoryIssueValuation")
  receivableReversalLines ReceivableInventoryLine[]   @relation("ReceivableInventoryReversalValuation")
  invoiceMatches          PurchaseOrderInvoiceMatch[]

  @@unique([stockMovementId, tenantId])
  @@unique([journalEntryId, tenantId])
  @@unique([id, tenantId])
  @@index([tenantId, productId, postedAt, id])
  @@index([tenantId, purchaseOrderId])
}

/// Append-only cost allocation from an outgoing issue to the receipt layer(s) it consumed.
model InventoryCostAllocation {
  id        String   @id @default(cuid())
  tenantId  String
  eventId   String
  layerId   String
  quantity  Int
  value     Decimal  @db.Decimal(19, 4)
  createdAt DateTime @default(now())

  tenant Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event  InventoryValuationEvent @relation(fields: [eventId, tenantId], references: [id, tenantId], onDelete: Restrict)
  layer  InventoryCostLayer      @relation(fields: [layerId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, eventId, layerId])
  @@index([tenantId, layerId])
}

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products ProductSupplier[]

  @@index([tenantId])
}

model ProductSupplier {
  id         String @id @default(cuid())
  productId  String
  supplierId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
}

model PurchaseOrder {
  id         String    @id @default(cuid())
  tenantId   String
  /// Finance vendor selected for this order. Nullable so historical orders remain valid; a
  /// purchase order without a vendor can be received but cannot be matched to a supplier bill.
  vendorId   String?
  status     String    @default("DRAFT")
  approvedAt DateTime?
  receivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant          Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor          Vendor?                     @relation(fields: [vendorId, tenantId], references: [id, tenantId], onDelete: Restrict)
  lines           PurchaseOrderLine[]
  payables        PayableInvoice[]
  valuationEvents InventoryValuationEvent[]
  invoiceMatches  PurchaseOrderInvoiceMatch[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, vendorId])
}

model PurchaseOrderLine {
  id              String   @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  /// Expected acquisition cost per unit. Required before receipt when the workspace has
  /// configured perpetual inventory valuation; nullable so historical quantity-only purchase
  /// orders remain valid rather than being backfilled with a guessed cost.
  unitCost        Decimal? @db.Decimal(19, 4)
  /// Currency of `unitCost`; must match the product/workspace valuation currency at receipt.
  currency        String?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// One exact match between a received, valued purchase-order line and the supplier bill that
/// clears its goods-received-not-invoiced balance. `activePurchaseOrderId` is unique while a
/// match is ACTIVE and becomes NULL when the match is reversed, so a replacement bill can match
/// the same receipt without deleting the historical match.
model PurchaseOrderInvoiceMatch {
  id                    String    @id @default(cuid())
  tenantId              String
  purchaseOrderId       String
  payableInvoiceId      String
  valuationEventId      String
  journalEntryId        String
  /// Mirrors `purchaseOrderId` while ACTIVE and is NULL after reversal.
  activePurchaseOrderId String?
  amount                Decimal   @db.Decimal(19, 4)
  currency              String
  status                String    @default("ACTIVE")
  reversedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder  PurchaseOrder           @relation(fields: [purchaseOrderId, tenantId], references: [id, tenantId], onDelete: Restrict)
  payableInvoice PayableInvoice          @relation(fields: [payableInvoiceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  valuationEvent InventoryValuationEvent @relation(fields: [valuationEventId, tenantId], references: [id, tenantId], onDelete: Restrict)
  journalEntry   JournalEntry            @relation(fields: [journalEntryId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, activePurchaseOrderId])
  @@index([tenantId, payableInvoiceId])
  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, valuationEventId])
  @@index([tenantId, journalEntryId])
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id           String        @id @default(cuid())
  tenantId     String
  currency     String?
  departmentId String?
  name         String
  budget       Decimal?      @db.Decimal(19, 4)
  spent        Decimal       @default(0) @db.Decimal(19, 4)
  timeline     DateTime?
  status       ProjectStatus @default(PLANNING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  milestones ProjectMilestone[]
  risks      ProjectRisk[]
  sprints    Sprint[]
  issues     Issue[]
  payables   PayableInvoice[]
  expenses   Expense[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model ProjectMilestone {
  id        String         @id @default(cuid())
  projectId String
  name      String
  state     MilestoneState @default(PENDING)
  sortOrder Int            @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectRisk {
  id        String       @id @default(cuid())
  projectId String
  title     String
  impact    String?
  severity  RiskSeverity @default(MEDIUM)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Sprint {
  id            String       @id @default(cuid())
  tenantId      String
  projectId     String?
  name          String
  status        SprintStatus @default(ACTIVE)
  startsAt      DateTime?
  endsAt        DateTime?
  completionPct Float        @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  issues  Issue[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model Issue {
  id          String        @id @default(cuid())
  tenantId    String
  sprintId    String?
  projectId   String?
  key         String?
  title       String
  tag         String?
  priority    IssuePriority @default(MEDIUM)
  status      IssueStatus   @default(TODO)
  storyPoints Int?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  sprint    Sprint?              @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  project   Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  checklist IssueChecklistItem[]
  comments  IssueComment[]
  assignees IssueAssignee[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, projectId])
  @@index([tenantId, sprintId, completedAt])
}

model IssueChecklistItem {
  id      String  @id @default(cuid())
  issueId String
  text    String
  done    Boolean @default(false)

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

model IssueComment {
  id        String   @id @default(cuid())
  issueId   String
  author    String
  body      String
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

model IssueAssignee {
  id         String @id @default(cuid())
  issueId    String
  employeeId String

  issue    Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([issueId, employeeId])
}

model RoadmapPhase {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks  RoadmapTask[]

  @@index([tenantId])
}

model RoadmapTask {
  id          String    @id @default(cuid())
  phaseId     String
  tenantId    String
  title       String
  taskCode    String?
  statusLabel String?
  description String?
  startDate   DateTime?
  endDate     DateTime?
  progressPct Float     @default(0)
  barColor    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  phase     RoadmapPhase          @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  assignees RoadmapTaskAssignee[]
  blocking  RoadmapDependency[]   @relation("BlockingTask")
  blockedBy RoadmapDependency[]   @relation("BlockedTask")
}

model RoadmapTaskAssignee {
  id            String @id @default(cuid())
  roadmapTaskId String
  employeeId    String

  task     RoadmapTask @relation(fields: [roadmapTaskId], references: [id], onDelete: Cascade)
  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([roadmapTaskId, employeeId])
}

model RoadmapDependency {
  id             String @id @default(cuid())
  blockingTaskId String
  blockedTaskId  String

  blockingTask RoadmapTask @relation("BlockingTask", fields: [blockingTaskId], references: [id], onDelete: Cascade)
  blockedTask  RoadmapTask @relation("BlockedTask", fields: [blockedTaskId], references: [id], onDelete: Cascade)

  @@unique([blockingTaskId, blockedTaskId])
}

// ─── Settings / Support ──────────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  tenantId             String
  planName             String
  priceMonthly         Decimal            @default(0) @db.Decimal(19, 4)
  status               SubscriptionStatus @default(ACTIVE)
  renewsOn             DateTime?
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  stripeCurrency       String?
  seatsUsed            Int                @default(1)
  seatLimit            Int                @default(10)
  storageUsedGb        Float              @default(0)
  storageLimitGb       Float              @default(100)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model PaymentMethod {
  id                    String   @id @default(cuid())
  tenantId              String
  stripePaymentMethodId String?  @unique
  brand                 String
  last4                 String
  expires               String?
  createdAt             DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model BillingInvoice {
  id              String   @id @default(cuid())
  tenantId        String
  date            DateTime
  description     String
  amount          Decimal  @db.Decimal(19, 4)
  status          String   @default("Paid")
  stripeInvoiceId String?  @unique
  stripeCurrency  String?
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model Integration {
  id               String            @id @default(cuid())
  tenantId         String
  name             String
  description      String?
  status           IntegrationStatus @default(CONFIGURE)
  syncPullRequests Boolean           @default(false)
  syncCiCdStatus   Boolean           @default(false)
  /**
   * Encrypted custom HTTPS endpoint URL used by endpoint health checks. Legacy token-like values
   * remain stored for compatibility but are never treated as endpoints or reported connected.
   * Never returned in full; settings.service.ts returns only a masked preview.
   */
  credential       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhookLogs WebhookLog[]

  @@index([tenantId])
}

model WebhookLog {
  id            String   @id @default(cuid())
  integrationId String
  statusCode    Int
  event         String
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id        String  @id @default(cuid())
  tenantId  String
  module    String
  eventType String
  inApp     Boolean @default(true)
  email     Boolean @default(true)
  slack     Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module, eventType])
}

model QuietHours {
  id       String @id @default(cuid())
  tenantId String @unique
  start    String @default("22:00")
  end      String @default("07:00")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  title       String
  message     String
  type        String   @default("INFO")
  link        String?
  read        Boolean  @default(false)
  availableAt DateTime @default(now())
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, read])
  @@index([tenantId, availableAt])
  @@index([tenantId, createdAt])
}

model ExportJob {
  id          String          @id @default(cuid())
  tenantId    String
  filename    String
  dataScope   String?
  format      String?
  dateRange   String?
  progressPct Float           @default(0)
  status      ExportJobStatus @default(QUEUED)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model BackupSchedule {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  schedule  String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model SupportTicket {
  id          String              @id @default(cuid())
  tenantId    String
  createdById String?
  subject     String
  channel     String?
  status      SupportTicketStatus @default(OPEN)
  createdAt   DateTime            @default(now())
  resolvedAt  DateTime?

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([createdById])
}
