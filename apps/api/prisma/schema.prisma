generator client {
  provider      = "prisma-client-js"
  // `native` covers local development; Vercel's Node runtime is Amazon Linux and needs the
  // RHEL OpenSSL 3 engine that ships with the generated client.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

