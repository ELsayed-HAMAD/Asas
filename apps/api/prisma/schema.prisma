generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum OnboardingStatus {
  PENDING
  EMPTY
  SAMPLE_LOADED
  IMPORTED
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  ARCHIVED
}

enum PayrollRunStatus {
  DRAFT
  PENDING
  APPROVED
  PAID
  VOID
}

enum LeaveType {
  VACATION
  SICK
  PERSONAL
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceExceptionType {
  MISSING_IN
  MISSING_OUT
  OVERTIME
}

enum CandidateStage {
  APPLIED
  SCREENING
  TECH_INTERVIEW
  FINAL_INTERVIEW
  OFFER_SENT
  HIRED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum PayableStatus {
  PENDING
  SCHEDULED
  APPROVED
  PAID
  REJECTED
  VOID
}

enum ReceivableStatus {
  CURRENT
  OVERDUE
  IN_COLLECTIONS
  PAID
  VOID
}

enum ExpenseCategory {
  SOFTWARE
  TRAVEL
  MEALS
  OFFICE_SUPPLIES
  FACILITIES_LEASE
  PAYROLL
  MARKETING
  OTHER
}

enum ExpenseStatus {
  PENDING
  FLAGGED
  PROCESSING
  APPROVED
  REIMBURSED
  REJECTED
  VOID
}

enum LedgerTxStatus {
  CLEARED
  PROCESSING
}

enum DealStage {
  LEADS
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum DealActivityType {
  CALL
  EMAIL
  NOTE
}

enum ProductStockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum ProjectStatus {
  PLANNING
  ON_TRACK
  DELAYED
  AT_RISK
  COMPLETED
}

enum MilestoneState {
  PENDING
  CURRENT
  COMPLETED
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
}

enum IssueStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
}

enum SprintStatus {
  ACTIVE
  COMPLETED
}

enum IntegrationStatus {
  CONNECTED
  CONFIGURE
  DISCONNECTED
}

enum ExportJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

// ─── Core ────────────────────────────────────────────────────────────────────

model Tenant {
  id                 String           @id @default(cuid())
  name               String
  slug               String           @unique
  supportEmail       String?
  logoUrl            String?
  metadata           String?
  timezone           String           @default("UTC")
  currency           String           @default("USD")
  currencyLockedAt   DateTime?
  dateFormat         String           @default("MMM d, yyyy")
  overtimeThresholdHours Float        @default(8)
  onboardingStatus   OnboardingStatus @default(PENDING)
  sampleDataManifest Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  members              Member[]
  invitations          Invitation[]
  auditLogs            AuditLog[]
  departments          Department[]
  activityEvents       ActivityEvent[]
  employees            Employee[]
  payrollRuns          PayrollRun[]
  timesheets           Timesheet[]
  attendanceExceptions AttendanceException[]
  leaveRequests        LeaveRequest[]
  leavePolicies        LeavePolicy[]
  candidates           Candidate[]
  vendors              Vendor[]
  payableInvoices      PayableInvoice[]
  customers            Customer[]
  receivableInvoices   ReceivableInvoice[]
  expenses             Expense[]
  ledgerTransactions   LedgerTransaction[]
  ledgerAccounts       LedgerAccount[]
  exchangeRates        ExchangeRate[]
  journalEntries       JournalEntry[]
  cashFlowSnapshots    CashFlowSnapshot[]
  companies            Company[]
  deals                Deal[]
  dealStageHistory     DealStageHistory[]
  crmHistoryCoverage   CrmHistoryCoverage?
  settlementHistoryCoverage SettlementHistoryCoverage?
  dealActivities       DealActivity[]
  agendaItems          AgendaItem[]
  salesQuotas          SalesQuota[]
  forecastSnapshots    ForecastSnapshot[]
  products             Product[]
  suppliers            Supplier[]
  purchaseOrders       PurchaseOrder[]
  projects             Project[]
  sprints              Sprint[]
  roadmapPhases        RoadmapPhase[]
  subscriptions        Subscription[]
  paymentMethods       PaymentMethod[]
  billingInvoices      BillingInvoice[]
  integrations         Integration[]
  notificationPrefs    NotificationPreference[]
  quietHours           QuietHours?
  exportJobs           ExportJob[]
  backupSchedules      BackupSchedule[]
  supportTickets       SupportTicket[]
}

// ─── Auth (Better Auth core + organization plugin, mapped onto Tenant) ───────
//
// `User` no longer carries `tenantId`/`passwordHash`/`role`/`employeeId` — a user's
// workspace membership, credential, and per-tenant role/employee link now live on `Member`,
// because a single person can belong to more than one tenant. See ADR note in the rebuild
// plan, Phase 1 §4 ("Better Auth — the one delicate migration").
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions             Session[]
  accounts             Account[]
  members              Member[]
  sentInvitations      Invitation[]   @relation("InvitationInviter")
  auditLogs            AuditLog[]
  exchangeRatesCreated ExchangeRate[]
}

model Session {
  id                   String   @id @default(cuid())
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Credential (email/password) and future OAuth accounts. `password` holds the bcrypt/scrypt
// hash for the `credential` provider — this is where `User.passwordHash` moved to.
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  /**
   * better-auth 1.7.2's internal adapter always writes this (e.g. "local:credential") —
   * confirmed by running an actual sign-up against a live database; not documented anywhere
   * I found ahead of time. Nullable here in case an older/newer better-auth version omits it.
   */
  issuer                String?
  userId                String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Email verification / password reset tokens.
model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

// The organization plugin's `member` model, mapped so its tenant column is named `tenantId`
// like every other one of the 60 ERP models (see apps/api/src/auth.ts). `role` intentionally
// reuses the `UserRole` enum rather than better-auth's default lowercase strings — see the
// note in auth.ts about the resulting gap in built-in permission checks.
model Member {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  employeeId String?  @unique
  role       UserRole @default(MEMBER)
  createdAt  DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId])
  @@index([tenantId])
}

model Invitation {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  role      UserRole @default(MEMBER)
  status    String   @default("pending")
  inviterId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inviter User   @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Append-only record of privileged actions (payroll approval, salary edits, member-role
// changes, …). Nothing in this codebase exposes an update or delete for this table — that is
// the "append-only" guarantee today. TODO(phase-1-hardening): enforce it at the database
// level too (a REVOKE + trigger, or a restricted DB role for the app connection) once there is
// a live database to verify that against; see the rebuild plan, Phase 1 §5.
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]
  projects  Project[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ActivityEvent {
  id        String   @id @default(cuid())
  tenantId  String
  module    String
  actorName String
  action    String
  target    String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, module])
  @@index([tenantId, createdAt])
}

// ─── HR ──────────────────────────────────────────────────────────────────────

enum SalaryBasis {
  ANNUAL
  MONTHLY
}

enum PayFrequency {
  MONTHLY
  SEMIMONTHLY
  BIWEEKLY
  WEEKLY
}

model Employee {
  id             String         @id @default(cuid())
  tenantId       String
  currency       String?
  departmentId   String?
  managerId      String?
  name           String
  title          String
  status         EmployeeStatus @default(ACTIVE)
  avatarUrl      String?
  hiredAt        DateTime?
  salary         Decimal?       @db.Decimal(19, 4)
  salaryBasis    SalaryBasis?
  equityOptions  Int?
  band           String?
  location       String?
  employeeNumber String?
  email          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department       Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager          Employee?             @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports          Employee[]            @relation("EmployeeManager")
  member           Member?
  payrollLines     PayrollLine[]
  timesheets       Timesheet[]
  exceptions       AttendanceException[]
  leaveRequests    LeaveRequest[]
  ownedDeals       Deal[]
  expenses         Expense[]
  issueAssignees   IssueAssignee[]
  roadmapAssignees RoadmapTaskAssignee[]
  hiredCandidate   Candidate?

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@index([tenantId, status])
}

model PayrollRun {
  id              String           @id @default(cuid())
  tenantId        String
  label           String
  payDate         DateTime?
  periodStart     DateTime?        @db.Date
  periodEnd       DateTime?        @db.Date
  payFrequency    PayFrequency?
  periodsPerYear  Int?
  salaryBasis     SalaryBasis?
  prorationMethod String?
  currency        String?
  paidAt          DateTime?
  paidById        String?
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?
  requestKey      String?
  requestHash     String?
  status          PayrollRunStatus @default(PENDING)
  /// JSON array of `{ label, rate }` rows — the tax/deduction rates this run was priced
  /// with, stored on the run so the tax split stays auditable and re-computable.
  taxRates        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines              PayrollLine[]
  settlementJournals JournalEntry[]

  @@unique([tenantId, requestKey])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, periodStart, periodEnd])
}

model PayrollLine {
  id               String       @id @default(cuid())
  tenantId         String
  payrollRunId     String
  employeeId       String
  gross            Decimal      @default(0) @db.Decimal(19, 4)
  deductions       Decimal      @default(0) @db.Decimal(19, 4)
  net              Decimal      @default(0) @db.Decimal(19, 4)
  baseSalary       Decimal?     @db.Decimal(19, 4)
  sourceSalary     Decimal?     @db.Decimal(19, 4)
  salaryBasis      SalaryBasis?
  eligibleDays     Int?
  periodDays       Int?
  missedDaysCount  Int?
  missedDaysAmount Decimal?     @db.Decimal(19, 4)
  bonusLabel       String?
  bonusAmount      Decimal?     @db.Decimal(19, 4)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  payrollRun PayrollRun       @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  taxLines   PayrollTaxLine[]

  @@index([tenantId])
  @@index([payrollRunId])
}

model PayrollTaxLine {
  id            String  @id @default(cuid())
  payrollLineId String
  label         String
  amount        Decimal @db.Decimal(19, 4)
  override      Boolean @default(false)

  payrollLine PayrollLine @relation(fields: [payrollLineId], references: [id], onDelete: Cascade)
}

model Timesheet {
  id            String    @id @default(cuid())
  tenantId      String
  employeeId    String
  weekStart     DateTime
  regularHours  Float     @default(0)
  overtimeHours Float     @default(0)
  totalHours    Float     @default(0)
  overtimeThresholdHours Float @default(8)
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  days     TimesheetDay[]

  @@unique([tenantId, employeeId, weekStart])
  @@index([tenantId])
}

model TimesheetDay {
  id          String    @id @default(cuid())
  timesheetId String
  date        DateTime? @db.Date
  dayLabel    String
  clockIn     String?
  clockOut    String?
  totalHours  Float?
  clockInAt   DateTime? @db.Timestamptz(3)
  clockOutAt  DateTime? @db.Timestamptz(3)

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@unique([timesheetId, date])
}

model AttendanceException {
  id         String                  @id @default(cuid())
  tenantId   String
  employeeId String
  type       AttendanceExceptionType
  label      String
  date       DateTime
  alert      Boolean                 @default(true)
  createdAt  DateTime                @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model LeaveRequest {
  id         String             @id @default(cuid())
  tenantId   String
  employeeId String
  type       LeaveType
  startDate  DateTime
  endDate    DateTime?
  status     LeaveRequestStatus @default(PENDING)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model LeavePolicy {
  id                   String   @id @default(cuid())
  tenantId             String
  type                 LeaveType
  annualAllowanceDays  Int
  weekdaysOnly         Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@index([tenantId])
}

model Candidate {
  id             String         @id @default(cuid())
  tenantId       String
  employeeId     String?
  name           String
  role           String
  stage          CandidateStage @default(APPLIED)
  stageEnteredAt DateTime       @default(now())
  timeInStage    String?
  appliedAt      DateTime       @default(now())
  avatarUrl      String?
  currentRole    String?
  experience     String?
  source         String?
  location       String?
  email          String?
  education      String?
  resumeUrl      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee   Employee?           @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: NoAction)
  activities CandidateActivity[]
  interviews CandidateInterview[]

  @@unique([employeeId, tenantId])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([tenantId, employeeId])
}

model CandidateActivity {
  id          String          @id @default(cuid())
  candidateId String
  action      String
  description String?
  fromStage   CandidateStage?
  toStage     CandidateStage?
  createdAt   DateTime        @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model CandidateInterview {
  id          String          @id @default(cuid())
  candidateId String
  startsAt    DateTime
  durationMin Int             @default(60)
  stage       CandidateStage
  interviewer String?
  meetingUrl  String?
  notes       String?
  status      InterviewStatus @default(SCHEDULED)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, startsAt])
}

// ─── Finance ─────────────────────────────────────────────────────────────────

model Vendor {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices PayableInvoice[]

  @@index([tenantId])
}

model PayableInvoice {
  id            String        @id @default(cuid())
  tenantId      String
  projectId     String?
  currency      String?
  vendorId      String
  invoiceNumber String?
  date          DateTime
  dueDate       DateTime?
  amount        Decimal       @db.Decimal(19, 4)
  status        PayableStatus @default(PENDING)
  pdfFilename   String?
  createdById   String?
  approvedById  String?
  approvedAt    DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project             Project?          @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: NoAction)
  vendor              Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  lineItems           PayableLineItem[]
  settlementJournals  JournalEntry[]
  recognitionJournals JournalEntry[]    @relation("PayableRecognition")

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, projectId])
}

model PayableLineItem {
  id            String  @id @default(cuid())
  invoiceId     String
  description   String
  periodOrUsage String?
  amount        Decimal @db.Decimal(19, 4)

  invoice PayableInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Customer {
  id               String           @id @default(cuid())
  tenantId         String
  name             String
  avatarUrl        String?
  collectionStatus ReceivableStatus @default(CURRENT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices   ReceivableInvoice[]
  activities CollectionActivity[]

  @@index([tenantId])
}

model ReceivableInvoice {
  id         String           @id @default(cuid())
  tenantId   String
  currency   String?
  customerId String
  number     String?
  amount     Decimal          @db.Decimal(19, 4)
  dueDate    DateTime?
  status     ReceivableStatus @default(CURRENT)
  paidAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer            Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  settlementJournals  JournalEntry[]
  recognitionJournals JournalEntry[] @relation("ReceivableRecognition")

  @@unique([id, tenantId])
  @@index([tenantId])
}

model CollectionActivity {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  title      String
  author     String?
  body       String?
  reminderId String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Expense {
  id             String          @id @default(cuid())
  tenantId       String
  projectId      String?
  currency       String?
  employeeId     String?
  name           String
  category       ExpenseCategory @default(OTHER)
  merchant       String?
  date           DateTime
  amount         Decimal         @db.Decimal(19, 4)
  tax            Decimal?        @db.Decimal(19, 4)
  policyMatch    Boolean?
  status         ExpenseStatus   @default(PENDING)
  receiptMeta    String?
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  reimbursedAt   DateTime?
  reimbursedById String?
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project            Project?       @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: NoAction)
  employee           Employee?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  settlementJournals JournalEntry[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, projectId])
}

model LedgerAccount {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  kind      String
  currency  String
  createdAt DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lines  JournalLine[]

  @@unique([tenantId, code, currency])
  @@unique([id, tenantId])
}

/// Manually maintained historical FX quotes expressed as base-currency units per one unit of `currency`.
model ExchangeRate {
  id          String   @id @default(cuid())
  tenantId    String
  currency    String
  rateToBase  Decimal  @db.Decimal(24, 12)
  effectiveAt DateTime
  source      String   @default("MANUAL")
  reference   String?
  createdById String?
  createdAt   DateTime @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy      User?          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  journalEntries JournalEntry[]

  @@unique([id, tenantId])
  @@unique([tenantId, currency, effectiveAt])
  @@index([tenantId, currency, effectiveAt])
}

model JournalEntry {
  id                            String   @id @default(cuid())
  tenantId                      String
  currency                      String
  amount                        Decimal  @db.Decimal(19, 4)
  baseCurrency                  String?
  baseAmount                    Decimal? @db.Decimal(19, 4)
  baseMinorUnitDigits           Int?
  fxRate                        Decimal? @db.Decimal(24, 12)
  exchangeRateId                String?
  sourceType                    String
  payableInvoiceId              String?
  receivableInvoiceId           String?
  payrollRunId                  String?
  expenseId                     String?
  recognizesPayableInvoiceId    String?
  recognizesReceivableInvoiceId String?
  reversesJournalEntryId        String?  @unique
  reversalReason                String?
  currencyProvenance            String
  description                   String
  actorId                       String?
  postedAt                      DateTime
  createdAt                     DateTime @default(now())

  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  exchangeRate         ExchangeRate?      @relation(fields: [exchangeRateId, tenantId], references: [id, tenantId], onDelete: Restrict)
  payable              PayableInvoice?    @relation(fields: [payableInvoiceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  receivable           ReceivableInvoice? @relation(fields: [receivableInvoiceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  payrollRun           PayrollRun?        @relation(fields: [payrollRunId, tenantId], references: [id, tenantId], onDelete: Restrict)
  expense              Expense?           @relation(fields: [expenseId, tenantId], references: [id, tenantId], onDelete: Restrict)
  recognizedPayable    PayableInvoice?    @relation("PayableRecognition", fields: [recognizesPayableInvoiceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  recognizedReceivable ReceivableInvoice? @relation("ReceivableRecognition", fields: [recognizesReceivableInvoiceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reverses             JournalEntry?      @relation("JournalReversal", fields: [reversesJournalEntryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reversedBy           JournalEntry?      @relation("JournalReversal")
  lines                JournalLine[]

  @@unique([id, tenantId])
  @@unique([tenantId, payableInvoiceId])
  @@unique([tenantId, receivableInvoiceId])
  @@unique([tenantId, payrollRunId])
  @@unique([tenantId, expenseId])
  @@unique([reversesJournalEntryId, tenantId])
  @@index([tenantId, recognizesPayableInvoiceId])
  @@index([tenantId, recognizesReceivableInvoiceId])
  @@index([tenantId, postedAt])
}

model JournalLine {
  id         String   @id @default(cuid())
  tenantId   String
  entryId    String
  accountId  String
  side       String
  amount     Decimal  @db.Decimal(19, 4)
  baseAmount Decimal? @db.Decimal(19, 4)

  entry   JournalEntry  @relation(fields: [entryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  account LedgerAccount @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, accountId])
  @@index([entryId])
}

model LedgerTransaction {
  id          String         @id @default(cuid())
  tenantId    String
  currency    String?
  date        DateTime
  description String
  amount      Decimal        @db.Decimal(19, 4)
  status      LedgerTxStatus @default(CLEARED)
  isCredit    Boolean        @default(true)
  createdAt   DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
}

model CashFlowSnapshot {
  id        String   @id @default(cuid())
  tenantId  String
  currency  String?
  month     String
  inflow    Decimal  @default(0) @db.Decimal(19, 4)
  outflow   Decimal  @default(0) @db.Decimal(19, 4)
  net       Decimal  @default(0) @db.Decimal(19, 4)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, month])
}

// ─── CRM ─────────────────────────────────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  tier      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deals  Deal[]

  @@index([tenantId])
}

model Deal {
  id              String    @id @default(cuid())
  tenantId        String
  currency        String?
  companyId       String?
  ownerEmployeeId String?
  name            String
  stage           DealStage @default(LEADS)
  value           Decimal   @default(0) @db.Decimal(19, 4)
  winProbability  Float?
  closeDate       DateTime?
  closedAt        DateTime?
  productLine     String?
  forecastBucket  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company      Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner        Employee?          @relation(fields: [ownerEmployeeId], references: [id], onDelete: SetNull)
  activities   DealActivity[]
  stageHistory DealStageHistory[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, closedAt])
  @@index([tenantId, stage])
}

model DealStageHistory {
  id              String     @id @default(cuid())
  tenantId        String
  dealId          String
  fromStage       DealStage?
  toStage         DealStage
  occurredAt      DateTime   @default(now())
  actorId         String?
  ownerEmployeeId String?
  value           Decimal    @db.Decimal(19, 4)
  isBaseline      Boolean    @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal   Deal   @relation(fields: [dealId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, occurredAt])
  @@index([dealId, occurredAt])
  @@index([tenantId, dealId, occurredAt(sort: Desc), id(sort: Desc)])
}

/** Earliest instant from which CRM stage history is complete for historical comparisons. */
model CrmHistoryCoverage {
  tenantId String   @id
  startsAt DateTime
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/** Earliest instant from which tenant settlement journals are complete for period comparisons. */
model SettlementHistoryCoverage {
  tenantId String   @id
  startsAt DateTime
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model DealActivity {
  id        String           @id @default(cuid())
  tenantId  String
  dealId    String
  type      DealActivityType @default(NOTE)
  title     String
  body      String?          @db.Text
  actorId   String?
  actorName String?
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal   Deal   @relation(fields: [dealId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, dealId, createdAt])
}

model AgendaItem {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  timeLabel String?
  priority  String?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model SalesQuota {
  id         String   @id @default(cuid())
  tenantId   String
  currency   String?
  employeeId String?
  repName    String
  period     String
  quota      Decimal  @db.Decimal(19, 4)
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ForecastSnapshot {
  id        String   @id @default(cuid())
  tenantId  String
  currency  String?
  repName   String
  period    String
  closed    Decimal  @default(0) @db.Decimal(19, 4)
  commit    Decimal  @default(0) @db.Decimal(19, 4)
  bestCase  Decimal  @default(0) @db.Decimal(19, 4)
  quotaPct  Float?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ─── Inventory ───────────────────────────────────────────────────────────────

model Product {
  id              String             @id @default(cuid())
  tenantId        String
  currency        String?
  name            String
  sku             String
  price           Decimal            @default(0) @db.Decimal(19, 4)
  stock           Int                @default(0)
  status          ProductStockStatus @default(IN_STOCK)
  warehouse       String?
  aisle           String?
  bin             String?
  avgMonthlyUsage Float?
  leadTimeDays    Int?
  minThreshold    Int                @default(10)
  archivedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements StockMovement[]
  suppliers ProductSupplier[]
  poLines   PurchaseOrderLine[]

  @@unique([tenantId, sku])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, archivedAt])
}

model StockMovement {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  delta     Int
  note      String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products ProductSupplier[]

  @@index([tenantId])
}

model ProductSupplier {
  id         String @id @default(cuid())
  productId  String
  supplierId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
}

model PurchaseOrder {
  id        String   @id @default(cuid())
  tenantId  String
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines  PurchaseOrderLine[]

  @@index([tenantId])
}

model PurchaseOrderLine {
  id              String @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id           String        @id @default(cuid())
  tenantId     String
  currency     String?
  departmentId String?
  name         String
  budget       Decimal?      @db.Decimal(19, 4)
  spent        Decimal       @default(0) @db.Decimal(19, 4)
  timeline     DateTime?
  status       ProjectStatus @default(PLANNING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  milestones ProjectMilestone[]
  risks      ProjectRisk[]
  sprints    Sprint[]
  issues     Issue[]
  payables   PayableInvoice[]
  expenses   Expense[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model ProjectMilestone {
  id        String         @id @default(cuid())
  projectId String
  name      String
  state     MilestoneState @default(PENDING)
  sortOrder Int            @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectRisk {
  id        String       @id @default(cuid())
  projectId String
  title     String
  impact    String?
  severity  RiskSeverity @default(MEDIUM)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Sprint {
  id            String       @id @default(cuid())
  tenantId      String
  projectId     String?
  name          String
  status        SprintStatus @default(ACTIVE)
  startsAt      DateTime?
  endsAt        DateTime?
  completionPct Float        @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  issues  Issue[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model Issue {
  id          String        @id @default(cuid())
  tenantId    String
  sprintId    String?
  projectId   String?
  key         String?
  title       String
  tag         String?
  priority    IssuePriority @default(MEDIUM)
  status      IssueStatus   @default(TODO)
  storyPoints Int?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  sprint    Sprint?              @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  project   Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  checklist IssueChecklistItem[]
  comments  IssueComment[]
  assignees IssueAssignee[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, projectId])
  @@index([tenantId, sprintId, completedAt])
}

model IssueChecklistItem {
  id      String  @id @default(cuid())
  issueId String
  text    String
  done    Boolean @default(false)

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

model IssueComment {
  id        String   @id @default(cuid())
  issueId   String
  author    String
  body      String
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

model IssueAssignee {
  id         String @id @default(cuid())
  issueId    String
  employeeId String

  issue    Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([issueId, employeeId])
}

model RoadmapPhase {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks  RoadmapTask[]

  @@index([tenantId])
}

model RoadmapTask {
  id          String    @id @default(cuid())
  phaseId     String
  tenantId    String
  title       String
  taskCode    String?
  statusLabel String?
  description String?
  startDate   DateTime?
  endDate     DateTime?
  progressPct Float     @default(0)
  barColor    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  phase     RoadmapPhase          @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  assignees RoadmapTaskAssignee[]
  blocking  RoadmapDependency[]   @relation("BlockingTask")
  blockedBy RoadmapDependency[]   @relation("BlockedTask")
}

model RoadmapTaskAssignee {
  id            String @id @default(cuid())
  roadmapTaskId String
  employeeId    String

  task     RoadmapTask @relation(fields: [roadmapTaskId], references: [id], onDelete: Cascade)
  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([roadmapTaskId, employeeId])
}

model RoadmapDependency {
  id             String @id @default(cuid())
  blockingTaskId String
  blockedTaskId  String

  blockingTask RoadmapTask @relation("BlockingTask", fields: [blockingTaskId], references: [id], onDelete: Cascade)
  blockedTask  RoadmapTask @relation("BlockedTask", fields: [blockedTaskId], references: [id], onDelete: Cascade)

  @@unique([blockingTaskId, blockedTaskId])
}

// ─── Settings / Support ──────────────────────────────────────────────────────

model Subscription {
  id             String             @id @default(cuid())
  tenantId       String
  planName       String
  priceMonthly   Decimal            @default(0) @db.Decimal(19, 4)
  status         SubscriptionStatus @default(ACTIVE)
  renewsOn       DateTime?
  seatsUsed      Int                @default(1)
  seatLimit      Int                @default(10)
  storageUsedGb  Float              @default(0)
  storageLimitGb Float              @default(100)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model PaymentMethod {
  id        String   @id @default(cuid())
  tenantId  String
  brand     String
  last4     String
  expires   String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model BillingInvoice {
  id          String   @id @default(cuid())
  tenantId    String
  date        DateTime
  description String
  amount      Decimal  @db.Decimal(19, 4)
  status      String   @default("Paid")
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Integration {
  id               String            @id @default(cuid())
  tenantId         String
  name             String
  description      String?
  status           IntegrationStatus @default(CONFIGURE)
  syncPullRequests Boolean           @default(false)
  syncCiCdStatus   Boolean           @default(false)
  /**
   * The stored integration credential (API key, token, …). Written by the settings module and
   * NEVER returned by any read endpoint — `settings.service.ts` masks it on the way out.
   */
  credential       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhookLogs WebhookLog[]

  @@index([tenantId])
}

model WebhookLog {
  id            String   @id @default(cuid())
  integrationId String
  statusCode    Int
  event         String
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id        String  @id @default(cuid())
  tenantId  String
  module    String
  eventType String
  inApp     Boolean @default(true)
  email     Boolean @default(true)
  slack     Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module, eventType])
}

model QuietHours {
  id       String @id @default(cuid())
  tenantId String @unique
  start    String @default("22:00")
  end      String @default("07:00")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ExportJob {
  id          String          @id @default(cuid())
  tenantId    String
  filename    String
  dataScope   String?
  format      String?
  dateRange   String?
  progressPct Float           @default(0)
  status      ExportJobStatus @default(QUEUED)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model BackupSchedule {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  schedule  String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model SupportTicket {
  id         String              @id @default(cuid())
  tenantId   String
  subject    String
  channel    String?
  status     SupportTicketStatus @default(OPEN)
  createdAt  DateTime            @default(now())
  resolvedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}
