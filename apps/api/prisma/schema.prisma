/// Manually maintained historical FX quotes expressed as base-currency units per one unit of `currency`.
model ExchangeRate {
  id          String   @id @default(cuid())
  tenantId    String
  currency    String
  rateToBase  Decimal  @db.Decimal(24, 12)
  effectiveAt DateTime
  source      String   @default("MANUAL")
  reference   String?
  createdById String?
  createdAt   DateTime @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy      User?          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  journalEntries JournalEntry[]

  @@unique([id, tenantId])
  @@unique([tenantId, currency, effectiveAt])
  @@index([tenantId, currency, effectiveAt])
}

model JournalEntry {
  id                            String   @id @default(cuid())
  tenantId                      String
  currency                      String
  amount                        Decimal  @db.Decimal(19, 4)
  baseCurrency                  String?
  baseAmount                    Decimal? @db.Decimal(19, 4)
  baseMinorUnitDigits           Int?
  fxRate                        Decimal? @db.Decimal(24, 12)
  exchangeRateId                String?
  sourceType                    String
  payableInvoiceId              String?
  receivableInvoiceId           String?
  payrollRunId                  String?
  expenseId                     String?
  recognizesPayableInvoiceId    String?
  recognizesReceivableInvoiceId String?
  recognizesPayrollRunId        String?
  recognizesExpenseId           String?
  reversesJournalEntryId        String?  @unique
  reversalReason                String?
  currencyProvenance            String
  description                   String
  actorId                       String?
  postedAt                      DateTime
  createdAt                     DateTime @default(now())

  tenant                           Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  exchangeRate                     ExchangeRate?               @relation(fields: [exchangeRateId, tenantId], references: [id, tenantId], onDelete: Restrict)
  payable                          PayableInvoice?             @relation(fields: [payableInvoiceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  receivable                       ReceivableInvoice?          @relation(fields: [receivableInvoiceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  payrollRun                       PayrollRun?                 @relation(fields: [payrollRunId, tenantId], references: [id, tenantId], onDelete: Restrict)
  expense                          Expense?                    @relation(fields: [expenseId, tenantId], references: [id, tenantId], onDelete: Restrict)
  recognizedPayable                PayableInvoice?             @relation("PayableRecognition", fields: [recognizesPayableInvoiceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  recognizedReceivable             ReceivableInvoice?          @relation("ReceivableRecognition", fields: [recognizesReceivableInvoiceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  recognizedPayrollRun             PayrollRun?                 @relation("PayrollRecognition", fields: [recognizesPayrollRunId, tenantId], references: [id, tenantId], onDelete: Restrict)
  recognizedExpense                Expense?                    @relation("ExpenseRecognition", fields: [recognizesExpenseId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reverses                         JournalEntry?               @relation("JournalReversal", fields: [reversesJournalEntryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reversedBy                       JournalEntry?               @relation("JournalReversal")
  lines                            JournalLine[]
  inventoryValuationEvent          InventoryValuationEvent?
  purchaseOrderInvoiceMatches      PurchaseOrderInvoiceMatch[]
  receivableInventoryIssueLines    ReceivableInventoryLine[]   @relation("ReceivableInventoryIssueJournal")
  receivableInventoryReversalLines ReceivableInventoryLine[]   @relation("ReceivableInventoryReversalJournal")

  @@unique([id, tenantId])
  @@unique([tenantId, payableInvoiceId])
  @@unique([tenantId, receivableInvoiceId])
  @@unique([tenantId, payrollRunId])
  @@unique([tenantId, expenseId])
  @@unique([reversesJournalEntryId, tenantId])
  @@index([tenantId, recognizesPayableInvoiceId])
  @@index([tenantId, recognizesReceivableInvoiceId])
  @@index([tenantId, postedAt])
}

model JournalLine {
  id         String   @id @default(cuid())
