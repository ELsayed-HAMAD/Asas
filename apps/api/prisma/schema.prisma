  recognitionJournals JournalEntry[]            @relation("ReceivableRecognition")
  inventoryLines      ReceivableInventoryLine[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

/// Optional stock fulfillment for one receivable invoice. The invoice remains a total-only
/// document; these lines record the costed inventory issue that funded it. Every original and
/// reversal movement, valuation event, and journal is retained so voiding an invoice restores
/// stock and cost without deleting history or inventing a new unit cost.
model ReceivableInventoryLine {
  id        String   @id @default(cuid())
  tenantId  String
  invoiceId String
  productId String
  quantity  Int
  currency  String
  costValue Decimal  @db.Decimal(19, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The original sale issue and its cost/accounting evidence.
  stockMovementId  String
  valuationEventId String
  journalEntryId   String?

  /// Set only when the invoice is voided or deleted. The reversal uses the exact original issue
  /// value; it is not recomputed from today's costing position.
  reversedAt               DateTime?
  reversalStockMovementId  String?
  reversalValuationEventId String?
  reversalJournalEntryId   String?

  tenant                 Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice                ReceivableInvoice        @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  product                Product                  @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  stockMovement          StockMovement            @relation("ReceivableInventoryIssueMovement", fields: [stockMovementId, tenantId], references: [id, tenantId], onDelete: Restrict)
  valuationEvent         InventoryValuationEvent  @relation("ReceivableInventoryIssueValuation", fields: [valuationEventId, tenantId], references: [id, tenantId], onDelete: Restrict)
  journalEntry           JournalEntry?            @relation("ReceivableInventoryIssueJournal", fields: [journalEntryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reversalStockMovement  StockMovement?           @relation("ReceivableInventoryReversalMovement", fields: [reversalStockMovementId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reversalValuationEvent InventoryValuationEvent? @relation("ReceivableInventoryReversalValuation", fields: [reversalValuationEventId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reversalJournalEntry   JournalEntry?            @relation("ReceivableInventoryReversalJournal", fields: [reversalJournalEntryId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([invoiceId, productId, tenantId])
  @@unique([stockMovementId, tenantId])
  @@unique([valuationEventId, tenantId])
  @@unique([journalEntryId, tenantId])
  @@unique([reversalStockMovementId, tenantId])
  @@unique([reversalValuationEventId, tenantId])
  @@unique([reversalJournalEntryId, tenantId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, productId])
}

