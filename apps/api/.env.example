# PostgreSQL connection string. Must match `provider` in prisma/schema.prisma.
# Local Docker/native install, or a hosted instance such as Neon (append ?sslmode=require).
DATABASE_URL="postgresql://user:password@localhost:5432/asas?schema=public"

PORT=4000
HOST="127.0.0.1"
FRONTEND_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Public origin of this API. Better Auth uses it for OAuth callbacks, verification/reset links,
# and the Secure/__Secure- cookie prefix. Development defaults to http://127.0.0.1:4000.
# Production must set this to the public HTTPS origin, for example https://api.example.com.
BETTER_AUTH_URL="http://127.0.0.1:4000"

# Signs/encrypts better-auth's session cookies. Generate with `openssl rand -base64 32`.
# Required in production (minimum 32 characters); tolerated in development only.
AUTH_SECRET=""

# Master key for AES-256-GCM encryption of integration credentials. Generate with
# `openssl rand -base64 48`. Required in production (minimum 32 characters) and must be
# different from AUTH_SECRET. Keep it stable: rotating it requires re-encrypting stored values.
ENCRYPTION_KEY=""

# Required in production for employee bank details encrypted at rest. Keep this key stable and
# separate from AUTH_SECRET; generate with `openssl rand -base64 48` and store in a secret manager.
BANK_DATA_ENCRYPTION_KEY=""

# Explicit reverse-proxy IPs/CIDRs allowed to set X-Forwarded-For/X-Forwarded-Proto.
# Leave empty when the API is directly exposed. Trust-all values (*, 0.0.0.0/0, ::/0, true)
# are rejected. Example behind a Docker bridge proxy: "172.16.0.0/12".
TRUSTED_PROXY_CIDRS=""

# Application-level tenant guard. "enforce" (default) injects the active tenant into every
# request-scoped Prisma operation on tenant-owned models and rejects cross-tenant references.
# "off" is accepted outside production only, for diagnostics. Production must use "enforce".
RLS_ENFORCEMENT="enforce"

# Optional. When set, bulk exports (employee directory, general ledger) are queued on pg-boss
# using this Postgres connection string (usually the same as DATABASE_URL). When empty, exports
# run inline in-process — the job-row bookkeeping is identical either way.
QUEUE_URL=""

# Optional live email delivery through Resend. The sender domain must be verified in Resend.
# Local testing can use onboarding@resend.dev, but that test sender cannot deliver to arbitrary
# recipients; production requires a verified domain and a matching MAIL_FROM address.
# If no API key is configured, email sends fail explicitly instead of being reported as sent.
RESEND_API_KEY=""
MAIL_FROM="Asas <noreply@example.com>"

# Optional S3-compatible storage (AWS S3 or Cloudflare R2). Local disk remains the default for
# development. R2 example: endpoint https://<account-id>.r2.cloudflarestorage.com, region auto.
OBJECT_STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Stripe hosted subscription billing (disabled until configured). Use test-mode credentials
# and recurring monthly Price IDs for staging. The webhook URL is /api/v1/billing/stripe/webhook.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_IDS=""

# Google OAuth 2.0 / OpenID Connect (Social SSO)
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs.
# Authorized Javascript Origins: http://localhost:5173 (or production domain)
# Authorized Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple Sign In
# Create Services ID and Keys in Apple Developer portal.
# APPLE_CLIENT_SECRET is the generated JWT client secret (not the .p8 private key). Apple rotates
# it; replace it before expiry or Apple sign-in will fail.
# Authorized Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/apple
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Local-only SSO sandbox for UI testing. loadEnv rejects this outside NODE_ENV=development.
DEV_SOCIAL_AUTH_ENABLED=false
