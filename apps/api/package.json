{
  "name": "@asas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "predev": "pnpm --filter @asas/domain build && pnpm --filter @asas/contracts build",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json",
    "lint": "tsc -p tsconfig.json && node scripts/check-tenant-filters.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "storage:migrate-local-to-s3": "tsx scripts/migrate-local-storage-to-s3.ts",
    "data:encrypt-employee-bank-details": "tsx scripts/encrypt-employee-bank-details.ts",
    "test": "vitest run --maxWorkers 2"
  },
  "dependencies": {
    "@asas/contracts": "workspace:*",
    "@asas/domain": "workspace:*",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@prisma/client": "6.19.3",
    "@sentry/node": "^11.10.0",
    "better-auth": "^1.7.14",
    "dotenv": "18.0.9",
    "exceljs": "4.4.0",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "0.20.2",
    "pg-boss": "12.38.1",
    "pino": "^10.4.0",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
