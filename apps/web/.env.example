# Absolute API origin used by the browser and baked into the build. Keep the loopback value for
# local development and leave it empty in production builds so every request stays same-origin
# behind nginx or Vercel. Setting it to a different host also requires that host in the CSP
# connect-src allow-list and in the API's FRONTEND_ORIGIN.
VITE_API_URL=http://127.0.0.1:4000

# Set to true when the API runs as a request-scoped function (Vercel): the SSE stream cannot be
# held open there, so the client refetches on interaction instead.
VITE_DISABLE_SSE=false

# Set to true to hide the "load sample data" affordances in the onboarding flow.
VITE_DISABLE_SAMPLE_DATA=false

# Optional browser error reporting. Without a DSN Sentry is not initialised.
VITE_SENTRY_DSN=
